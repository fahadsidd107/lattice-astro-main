---
import c from "../content.json";
---
<!doctype html>
<html lang={c.site.lang}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{c.site.title}</title>
<meta name="description" content={c.site.description}>
<link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%23141414%22/><text x=%2250%22 y=%2265%22 text-anchor=%22middle%22 font-size=%2250%22 fill=%22%2343cabc%22>F</text></svg>">
<script is:inline>// Layout mode before first paint: L = pinned screens on a fixed grid, F = flowing page on a scrolling grid.
  // "lines" hides boxes until they scroll into view, then slides them in and draws their frames.
  // The intro plays once per tab session and never for reduced motion.
  (function () {
    var root = document.documentElement;
    root.classList.add("js");
    try {
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches && !sessionStorage.getItem("lattice-intro")) root.classList.add("js-intro");
    } catch (e) {}
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches && "IntersectionObserver" in window) root.classList.add("lines");
  })();</script>
<link rel="stylesheet" href="/site.css">
</head>
<body>
<canvas class="lattice-orb" data-lattice-orb aria-hidden="true"></canvas>
<slot />
<script is:inline src="/site.js" defer></script>
</body>
</html>
