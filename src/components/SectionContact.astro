---
const accessKey = import.meta.env.PUBLIC_FORMGONG_ACCESS_KEY || "";
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <header class="section-head"><p class="eyebrow">Contact / 05</p><h2 id="contact-title">Let’s make the system <span>work.</span></h2><p>Hiring for a product team, shaping a platform, or looking for an experienced technical partner? Tell me what needs to move.</p></header>
  <div class="contact-grid">
    <aside class="contact-info frame-box"><p class="mono">DIRECT CHANNELS</p><a href="mailto:fsiddiqui107@gmail.com">fsiddiqui107@gmail.com <span>↗</span></a><a href="tel:+4917623876395">+49 176 23876395 <span>↗</span></a><a href="https://github.com/fahadsidd107" target="_blank" rel="noopener noreferrer">GitHub <span>↗</span></a><a href="https://www.linkedin.com/in/muhammad-fahad-siddiqui-595484176/" target="_blank" rel="noopener noreferrer">LinkedIn <span>↗</span></a><div class="contact-location"><span class="status-dot"></span><p>Frankfurt am Main, Germany<br><small>Europe / Berlin</small></p></div></aside>
    {accessKey ? <form id="contact-form" class="contact-form frame-box" action="https://formgong.com/submit" method="POST"><input type="hidden" name="access_key" value={accessKey}/><input type="hidden" name="_lang" value="en"/><div class="honeypot" aria-hidden="true"><label>Leave empty<input name="botcheck" tabindex="-1" autocomplete="off"/></label></div><label><span>01 / NAME</span><input name="name" required maxlength="80" autocomplete="name" placeholder="Your name"/></label><label><span>02 / EMAIL</span><input name="email" type="email" required maxlength="120" autocomplete="email" placeholder="you@company.com"/></label><label><span>03 / MESSAGE</span><textarea name="message" required maxlength="3000" placeholder="What are you building or hiring for?"></textarea></label><button type="submit">Send message <span>→</span></button><p class="form-status" role="status"></p></form> : <div class="form-fallback frame-box"><p class="mono">FORM CHANNEL / OFFLINE</p><h3>Prefer a direct line?</h3><p>The form endpoint has not been configured yet. Email me and your message will arrive without a detour.</p><a href="mailto:fsiddiqui107@gmail.com?subject=Portfolio%20enquiry">Compose an email <span>→</span></a></div>}
  </div>
</section>
